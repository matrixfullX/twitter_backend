# Local development with docker compose (PostgreSQL service is named "db")
# Copy to .env. Replace every CHANGE_ME value; never commit .env.
ENV=development
SECRET_KEY=CHANGE_ME_generate_a_long_random_Django_secret
ALLOWED_HOSTS=127.0.0.1 localhost

# PostgreSQL (docker-compose.yml)
TYPE_DATABASE=postgresql
DB_ENGINE=django.db.backends.postgresql
DB_NAME=twitter
DB_USER=twitter
DB_PASSWORD=CHANGE_ME_local_database_password
DB_HOST=db
DB_PORT=5432

# Local account verification: activation messages appear in `docker compose logs api`.
# No SMTP account or paid email service is needed for local testing.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_TIMEOUT=15

# Redis (docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional image storage. Leave blank if Cloudinary is not configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local React development URLs
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000
DOMAIN_FRONTEND=http://localhost:3000

# Optional Google OAuth. Leave empty to use email/password login only.
# If configured, copy the Client ID to the frontend; keep the secret only here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
